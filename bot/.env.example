# Project Chronos — bot environment template
#
# NAMES ONLY. Never put a real value in this file, never commit a real .env.
# Copy to `bot/.env` (git-ignored) and fill in locally.
#
# ---------------------------------------------------------------------------
# PHASE 1 (current): NOTHING HERE IS NEEDED.
# Phase 1 is historical CSV replay — no MT5 connection, no Supabase, no order
# placement. `bot/historical_validation/validate_against_history.py --csv ...`
# runs with no environment at all.
# ---------------------------------------------------------------------------
#
# The variables below become required in later phases only:

# --- MT5 terminal (Phase 2 dry-run onwards; Windows-only package) ----------
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# --- Supabase (Phase 2 onwards; the bot uses the service role key, which
#     bypasses RLS as a trusted backend process — see schema doc §5) ---------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Instrument ------------------------------------------------------------
# Confirmed value: NAS100
INSTRUMENT_SYMBOL=NAS100

# --- Safeguards (Phase 3/4) ------------------------------------------------
# ENVIRONMENT must be "demo" or "live". Live additionally requires
# CONFIRM_LIVE_TRADING=true; the bot must refuse to run live if either is
# missing (docs/06-IMPLEMENTATION-PLAN.md §5).
ENVIRONMENT=demo
CONFIRM_LIVE_TRADING=false
